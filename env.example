# Safaricom Daraja API credentials - keep these server-side; never expose in React.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
# Must be a publicly reachable HTTPS URL pointing to /api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
PORT=3000
